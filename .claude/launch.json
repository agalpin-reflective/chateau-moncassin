{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "dev-paiement",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["astro", "dev", "--port", "4323"],
      "port": 4323,
      "env": { "PUBLIC_PAYMENT_ENABLED": "true" }
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview",
        "--port",
        "4322"
      ],
      "port": 4322,
      "env": {
        "BASE_PATH": "/chateau-moncassin",
        "SITE_URL": "https://agalpin-reflective.github.io"
      }
    }
  ]
}
