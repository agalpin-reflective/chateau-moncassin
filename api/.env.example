# Environnement : development, test ou production.
NODE_ENV=development
PORT=4100

# Adresse publique du site (liens des emails, adresses de retour après paiement), sans barre finale.
SITE_URL=http://localhost:4321
# Adresse publique de cette API telle que la banque doit l'appeler (notification de paiement), sans barre finale.
# En production : https://parrains.chateaumoncassin.com/api
PUBLIC_API_URL=http://localhost:4100

# Postgres.
DATABASE_URL=postgres://moncassin:moncassin@localhost:5433/moncassin

# Up2pay e-Transactions (Crédit Agricole).
# Plateforme : « test » (préproduction de la banque) ou « production ».
ETRANSACTIONS_MODE=test
# Compte de démonstration public de la banque, documenté dans « e-Transactions : mise en place des tests ».
# En production : les identifiants du contrat du château. Ne jamais commiter la clé de production.
ETRANSACTIONS_SITE=1999887
ETRANSACTIONS_RANG=32
ETRANSACTIONS_IDENTIFIANT=215
ETRANSACTIONS_HMAC_KEY=0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF
# Clé publique de la banque (fichier pubkey.pem) qui signe les notifications de paiement.
# Sans elle, aucune notification n'est acceptée et aucune commande ne passe à « payée ».
ETRANSACTIONS_PUBLIC_KEY_FILE=keys/etransactions-pubkey.pem

# Envoi des emails (compte SMTP du château). Sans SMTP_HOST, les emails sont seulement journalisés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Château Moncassin <parrainage@exemple.fr>"
# Adresse du château qui reçoit le détail de chaque commande payée.
ORDERS_EMAIL=
