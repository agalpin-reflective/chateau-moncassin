{
  "name": "chateau-moncassin-api",
  "version": "1.0.0",
  "private": true,
  "description": "API du Cercle des parrains : commandes, paiement Up2pay e-Transactions (Crédit Agricole), emails.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start:production": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.28",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
