---
import Logo from './Logo.astro';
import { site } from '../data/site';
---
<section class="tagline" aria-label="Notre promesse">
  <div class="wrap">
    <div class="tagline-inner">
      <p class="tagline-text" id="tagline">Une année entière au rythme de la vigne, et une journée au domaine quand vient la récolte.</p>
      <p class="tagline-sign"><Logo size="sm" /> {site.club}</p>
    </div>
  </div>
</section>
