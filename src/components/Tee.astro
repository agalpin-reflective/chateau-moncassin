---
/**
 * Aperçu du tee shirt de la formule domaine : sur le cœur, le logo du château, « Le Cercle des parrains »
 * et l'année d'inscription. Le dos est neutre. L'impression étant petite, une loupe la montre en grand.
 */
import Icon from './Icon.astro';
import { logo } from '../data/logo';
import { site } from '../data/site';
import { tee } from '../data/content';
import { href } from '../lib/url';

const year = new Date().getFullYear();
/* Gabarit de 480 × 520 : manches à plat, col en haut. */
const neck = 'C292 96 188 96 176 44';
const outline = `M176 44L112 66L24 132L66 204L120 168V478Q120 494 136 494H344Q360 494 360 478V168L414 204L456 132L368 66L304 44${neck}Z`;
/* Vu de face, l'intérieur du dos apparaît dans l'encolure. */
const inside = `M176 44C194 64 286 64 304 44${neck}Z`;
const seams = 'M35 125L77 197M445 125L403 197M120 480H360';
const folds = 'M120 168C125 204 121 236 127 268M360 168C355 204 359 236 353 268';
/* L'impression, centrée sur le cœur (à droite pour qui regarde le tee shirt). */
const heart = { x: 296, y: 150 };
const logoWidth = 56;
const logoHeight = (logoWidth * (logo.height + 8)) / (logo.width + 8);
/* Fenêtre de la loupe sur le gabarit : un carré autour de l'impression. */
const zoom = { x: heart.x - 46, y: heart.y - 14, size: 92 };
---
<section class="section tee-section" id="tee" aria-labelledby="tee-title">
  <div class="wrap">
    <div class="tee-grid">
      <div class="tee-copy">
        <p class="eyebrow" data-reveal>{tee.eyebrow}</p>
        <h2 class="h2" id="tee-title" data-split>{tee.title}</h2>
        <p class="lead" data-reveal>{tee.text}</p>
        <ul class="tee-points" data-reveal>
          {tee.points.map((p) => <li><Icon name={p.icon} /> {p.text}</li>)}
        </ul>
        <div class="tee-actions" data-reveal>
          <a class="btn btn-primary" href={`${href('souscrire')}?formule=domaine`}>Choisir la formule domaine <Icon name="arrow-right-linear" class="i-arrow" /></a>
        </div>
        <p class="fine" data-reveal><Icon name="info-circle-linear" size="sm" /> {tee.note}</p>
      </div>

      <div class="tee-visual" data-reveal>
        <div class="tee-stage">
          <div class="tee-tilt">
            <svg class="tee" viewBox="0 0 480 520" role="img" aria-label={`Le tee shirt vu de face : sur le cœur, le logo du ${site.name}, ${tee.print} et l'année ${year}. Le dos est neutre.`}>
              <defs>
                <g id="tee-print" class="tee-print">
                  <use class="tee-logo" href="#logo-cm" x={heart.x - logoWidth / 2} y={heart.y} width={logoWidth} height={logoHeight}></use>
                  <text class="tee-name" x={heart.x} y={heart.y + logoHeight + 13}>{tee.print}</text>
                  <text class="tee-year" x={heart.x} y={heart.y + logoHeight + 29} data-tee-year>{year}</text>
                </g>
                <clipPath id="tee-zoom-clip"><circle cx="372" cy="398" r="96"></circle></clipPath>
              </defs>
              <path class="tee-inside" d={inside}></path>
              <path class="tee-fabric" d={outline}></path>
              <path class="tee-rib" d="M166 48C182 110 298 110 314 48"></path>
              <path class="tee-seam" d={seams}></path>
              <path class="tee-fold" d={folds}></path>
              <use href="#tee-print"></use>
              <!-- La loupe : le même tracé d'impression, agrandi dans un cercle. -->
              <circle class="tee-zoom-target" cx={zoom.x + zoom.size / 2} cy={zoom.y + zoom.size / 2} r={zoom.size / 2}></circle>
              <path class="tee-zoom-link" d={`M${zoom.x + zoom.size / 2 + 26} ${zoom.y + zoom.size - 4}L348 306`}></path>
              <g clip-path="url(#tee-zoom-clip)">
                <circle class="tee-zoom-disc" cx="372" cy="398" r="96"></circle>
                <use href="#tee-print" transform={`translate(372 398) scale(${192 / zoom.size}) translate(${-(zoom.x + zoom.size / 2)} ${-(zoom.y + zoom.size / 2)})`}></use>
              </g>
              <circle class="tee-zoom-ring" cx="372" cy="398" r="96"></circle>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
