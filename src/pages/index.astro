---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Principe from '../components/Principe.astro';
import Annee from '../components/Annee.astro';
import Experience from '../components/Experience.astro';
import Tagline from '../components/Tagline.astro';
import Formules from '../components/Formules.astro';
import Privileges from '../components/Privileges.astro';
import Etapes from '../components/Etapes.astro';
import Faq from '../components/Faq.astro';
import Souscription from '../components/Souscription.astro';
---
<BaseLayout
  page="home"
  title="Parrainez un pied de vigne · Château Moncassin"
  description="Devenez parrain symbolique d'un pied de vigne au Château Moncassin : bouteilles livrées, journée de vendanges avec repas et douze mois de privilèges au domaine, pour 150 € TTC."
>
  <Hero />
  <Principe />
  <Annee />
  <Experience />
  <Tagline />
  <Formules />
  <Privileges />
  <Etapes />
  <Faq />
  <Souscription />
</BaseLayout>
