# URL publique du site, sans barre finale (canonical, sitemap, images de partage).
SITE_URL=https://www.exemple.fr

# Paiement en ligne (Crédit Agricole, Up2pay e-Transactions), traité par l'API du dépôt chateau-moncassin-api.
# Laisser vide pour garder le formulaire en mode démonstration ; « true » pour proposer le paiement.
PUBLIC_PAYMENT_ENABLED=
# Adresse de l'API. Par défaut /api, sur le même domaine que le site.
PUBLIC_API_URL=
